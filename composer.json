{
  "name": "kr0lik/php-cs-fixer",
  "type": "library",
  "description": "Code style fixer",
  "require": {
    "php": "^8.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "kr0lik\\CodeStyleFixer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kr0lik\\CodeStyleFixer\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/"
    ]
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  }
}
